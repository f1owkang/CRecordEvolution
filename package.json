{
  "name": "cre-record-evolution-webui",
  "version": "1.3.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:offline": "node scripts/check-offline.mjs",
    "check:size": "node scripts/check-size.mjs",
    "verify": "vite build && node scripts/check-offline.mjs && node scripts/check-size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"webui/**/*.{js,jsx,css,html}\" \"scripts/**/*.mjs\" \"vite.config.js\"",
    "format:check": "prettier --check \"webui/**/*.{js,jsx,css,html}\" \"scripts/**/*.mjs\" \"vite.config.js\""
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@preact/preset-vite": "2.10.6",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
